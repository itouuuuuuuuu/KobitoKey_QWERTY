#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/*
 * zmk-config-moNa2-v2 (元は zmk-config-roBa) のキーマップを KobitoKey (40 キー) へ移植したもの。
 * moNa2 (42 キー) と比べて、2 行目の右内側キー (Cmd++ / Cmd+-) と
 * 3 行目の左右内側キー ([ ] / { }) が無いので、各レイヤーからその 3 箇所を除いている。
 * 親指行は moNa2 が左 6 + 右 3、KobitoKey が左 5 + 右 5 なので、
 * 左端の Tab を右親指の内側 (index 35) に移し、余った index 38 に Cmd++ / Cmd+- を仮置きしている。
 * ロータリーエンコーダは無いため sensor-bindings は無し。
 *
 * macOS 前提 (LG = Command、LA = Option)。日本語入力は LANG1 / LANG2 で切替。
 * 右トラックボールのオートマウスレイヤー (layer 4) は
 * boards/shields/KobitoKey/KobitoKey_left.overlay の &zip_temp_layer で指定している。
 *
 * index:
 *   0- 9  1 行目 / 10-19  2 行目 / 20-29  3 行目
 *  30-34  左親指行 (30,31 は小指・薬指側、32-34 が親指クラスタ)
 *  35-39  右親指行 (35-37 が親指クラスタ、38,39 は薬指・小指側)
 */

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        /* LANG2 キー + Backspace キーの同時押しで LANG1 (moNa2 の 33 + 39 に相当) */
        lang1 {
            bindings = <&kp LANGUAGE_1>;
            key-positions = <30 36>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        mt_slow: mt_slow {
            compatible = "zmk,behavior-hold-tap";
            label = "MOD_TAP_SLOW";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <300>;
            quick-tap-ms = <0>;
        };

        mt_fast: mt_fast {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_FAST";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <145>;
            quick-tap-ms = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "DEFAULT";
            bindings = <
&lt 8 Q                &kp W                    &kp E                     &kp R  &kp T        &kp Y                      &kp U                 &kp I                 &kp O                 &kp P
&mt_slow LEFT_SHIFT A  &kp S                    &kp D                     &kp F  &kp G        &kp H                      &kp J                 &kp K                 &kp L                 &kp MINUS
&kp Z                  &mt_slow LS(LEFT_ALT) X  &mt_slow LS(LEFT_META) C  &kp V  &kp B        &kp N                      &kp M                 &mt RIGHT_META COMMA  &mt RIGHT_ALT PERIOD  &mt_fast RCTRL SLASH
&lt 7 LANG2            &mo 6                    &mo 3                     &mo 1  &lt 2 SPACE  &lt_to_layer_0 5 TAB       &mt RIGHT_SHIFT BACKSPACE  &mt RIGHT_META ENTER  &kp LG(PLUS)     &kp ESCAPE
            >;
        };

        layer_1 {
            display-name = "SYM";
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN  &kp HASH   &kp DOLLAR          &kp PERCENT  &kp AMPERSAND     &kp CARET          &kp ASTERISK   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp PIPE         &kp GRAVE    &kp PLUS   &kp COLON           &kp EQUAL    &kp LEFT_ARROW    &kp DOWN_ARROW     &kp UP_ARROW   &kp RIGHT_ARROW       &kp SEMICOLON
&kp BACKSLASH    &trans       &kp TILDE  &kp LS(UNDERSCORE)  &trans       &kp SINGLE_QUOTE  &kp DOUBLE_QUOTES  &kp LESS_THAN  &kp GREATER_THAN      &kp QUESTION
&trans           &trans       &trans     &trans              &trans       &trans            &trans             &trans         &kp LG(MINUS)         &trans
            >;
        };

        layer_2_mouse_click_and_func {
            display-name = "FUNC";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7              &kp F8     &kp F9               &kp F10
&trans  &trans  &trans  &trans  &trans  &trans  &mkp LCLK           &mkp RCLK  &mkp MCLK            &kp F11
&trans  &trans  &trans  &trans  &trans  &trans  &kp LC(LEFT_ARROW)  &trans     &kp LC(RIGHT_ARROW)  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &trans              &trans     &trans               &trans
            >;
        };

        layer_3_text_select {
            display-name = "TXT_SEL";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans                  &trans                &trans             &trans
&trans  &trans  &trans  &trans  &trans  &kp LG(LS(LEFT_ARROW))  &kp LG(LS(DOWN_ARROW))  &kp LG(LS(UP_ARROW))  &kp LG(LS(RIGHT))  &trans
&trans  &trans  &trans  &trans  &trans  &kp LG(LEFT)            &kp LG(DOWN)            &kp LG(UP)            &kp LG(RIGHT)      &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans                  &trans                &trans             &trans
            >;
        };

        /* 右トラックボールのオートマウスレイヤー (KobitoKey_left.overlay の &zip_temp_layer 4 ...) */
        layer_4_mouse_layer {
            display-name = "MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans     &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &mkp LCLK  &mkp RCLK  &mkp MCLK  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans     &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans     &trans     &trans
            >;
        };

        /* moNa2 ではトラックボールがスクロールになるレイヤー。KobitoKey は左ボールが常時スクロールなのでテンキーのみ */
        layer_5_num {
            display-name = "NUM";
            bindings = <
&trans  &trans                &trans         &trans  &trans  &trans  &kp N7  &kp N8  &kp N9  &trans
&trans  &kp LS(LG(NUMBER_4))  &trans         &trans  &trans  &trans  &kp N4  &kp N5  &kp N6  &trans
&trans  &trans                &kp LS(LC(C))  &trans  &trans  &trans  &kp N1  &kp N2  &kp N3  &trans
&trans  &trans                &trans         &trans  &trans  &trans  &trans  &kp N0  &trans  &trans
            >;
        };

        layer_6 {
            display-name = "OPT_ARW";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans                  &trans                &trans                   &trans
&trans  &trans  &trans  &trans  &trans  &kp LA(LS(LEFT_ARROW))  &kp LA(LS(DOWN_ARROW))  &kp LA(LS(UP_ARROW))  &kp LA(LS(RIGHT_ARROW))  &trans
&trans  &trans  &trans  &trans  &trans  &kp LA(LEFT)            &kp LA(DOWN)            &kp LA(UP)            &kp LA(RIGHT)            &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans                  &trans                &trans                   &trans
            >;
        };

        layer_7_change_browser_tab {
            display-name = "TAB";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &kp LG(NUMBER_7)  &kp LG(NUMBER_8)  &kp LG(NUMBER_9)  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp LG(NUMBER_4)  &kp LG(NUMBER_5)  &kp LG(NUMBER_6)  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp LG(NUMBER_1)  &kp LG(NUMBER_2)  &kp LG(NUMBER_3)  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans            &kp LG(NUMBER_0)  &trans            &trans
            >;
        };

        /* Q 長押しで入る。W の位置に &studio_unlock (ZMK Studio のアンロック) */
        layer_8_move_window {
            display-name = "WIN_MGMT";
            bindings = <
&trans  &studio_unlock  &trans  &trans         &trans  &kp LS(LC(Y))          &trans             &trans         &kp LS(LC(O))    &kp LS(LC(P))
&trans  &trans          &trans  &kp LS(LC(F))  &trans  &kp LS(LC(H))          &kp LS(LC(J))      &kp LS(LC(K))  &kp LC(LS(L))    &trans
&trans  &trans          &trans  &trans         &trans  &kp LS(LC(N))          &trans             &trans         &kp LS(LC(DOT))  &trans
&trans  &trans          &trans  &trans         &trans  &trans                 &kp LS(LC(BACKSPACE))  &kp LS(LC(ENTER))  &trans       &trans
            >;
        };
    };
};
